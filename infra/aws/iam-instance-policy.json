{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAndStoreAppSecrets",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters", "ssm:GetParametersByPath", "ssm:PutParameter"],
      "Resource": "arn:aws:ssm:*:*:parameter/retail/*"
    },
    {
      "Sid": "ReadDatabaseBackup",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::retail-backups-*/*"
    }
  ]
}
